DISCORD_TOKEN=your-discord-bot-token
DISCORD_APP_ID=your-discord-application-id
# Optional: set to restrict slash command registration to a single guild during testing
DISCORD_GUILD_ID=your-guild-id
JELLYSEERR_API_URL=https://your-jellyseerr.example.com
JELLYSEERR_API_KEY=your-jellyseerr-api-key

# Optional: /status debug logging
STATUS_DEBUG=false

# Optional: where /status should pull download progress from
# - auto (default): Jellyseerr + Radarr/Sonarr queue if configured
# - jellyseerr: only Jellyseerr
# - radarr: prefer Radarr (movie)
# - sonarr: prefer Sonarr (tv)
STATUS_SOURCE=auto

# Optional: Radarr integration (movie download progress)
RADARR_URL=http://radarr:7878
RADARR_API_KEY=your-radarr-api-key

# Optional: Sonarr integration (tv download progress)
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=your-sonarr-api-key
